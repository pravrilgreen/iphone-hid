# iphone-hid box: at boot, make this board the iPhone's USB touch pointer and keyboard.
[Unit]
Description=iphone-hid: the USB touch pointer and keyboard gadget
Before=ihcd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# the USB controller driver may come up a little after boot: wait for it (up to 30 s)
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && exit 0; sleep 1; done; echo "no USB device controller: the USB-C port is in host mode" >&2; exit 1'
ExecStartPre=-/sbin/modprobe libcomposite
ExecStart=/opt/ihc/bin/ihcd gadget up --replace --owner ihc
ExecStop=/opt/ihc/bin/ihcd gadget down

[Install]
WantedBy=multi-user.target
