# Pointer layer: absolute pointer only (BRIDGE_POINTERS_ABS_ONLY). Layered on sdkconfig.defaults
# (BLE) or on sdkconfig.defaults + sdkconfig.defaults.usb (USB). Hardware test T1 run B (the
# reference layout: own USB interface, no report id, 0..32767) and T9 over BLE; see README.
#   USB: idf.py -B build_usb_abs -D SDKCONFIG=build_usb_abs/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.usb;sdkconfig.defaults.abs_only" \
#          set-target esp32s3 build
#   BLE: idf.py -B build_abs -D SDKCONFIG=build_abs/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.abs_only" set-target esp32s3 build

CONFIG_BRIDGE_POINTERS_ABS_ONLY=y
