# iphone-hid all-in-one box: at boot, make this board the iPhone's USB keyboard and mouse
# (Linux USB gadget on the board's device-capable USB-C port; see docs/gadget.md).
[Unit]
Description=iphone-hid: this board as the iPhone's USB keyboard and mouse
Before=ihc.service

[Service]
Type=oneshot
RemainAfterExit=yes
# the USB controller driver may come up a little after boot: wait for it (up to 30 s)
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && exit 0; sleep 1; done; echo "no USB device controller: the USB-C port is in host mode" >&2; exit 1'
ExecStart=/opt/ihc/.venv/bin/ihc gadget up --replace --owner ihc
ExecStop=/opt/ihc/.venv/bin/ihc gadget down

[Install]
WantedBy=multi-user.target
