# iphone-hid control box: starts at boot, finds the rigs by itself, restarts on failure.
[Unit]
Description=iphone-hid control box
Wants=network-online.target ihc-gadget.service
After=network-online.target ihc-gadget.service

[Service]
Type=simple
User=ihc
Group=ihc
SupplementaryGroups=dialout video input
Environment=IHC_STATE_DIR=/var/lib/ihc
# optional settings, e.g. IHC_PHONE_ID=iphone15-a01 to name this box's phone (default: iphone-<board serial>)
EnvironmentFile=-/etc/default/ihc
StateDirectory=ihc
LogsDirectory=ihc
# the API token (made once by install.sh): clients send it as "Authorization: Bearer <token>"
ExecStart=/opt/ihc/.venv/bin/ihc serve --auto --state-dir /var/lib/ihc --token-file /var/lib/ihc/token --host 0.0.0.0 --port 8000 --log /var/log/ihc/ihc.jsonl
Restart=always
RestartSec=2
# report pacing is timing sensitive: run ahead of ordinary background work
Nice=-5

[Install]
WantedBy=multi-user.target
