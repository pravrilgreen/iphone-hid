# iphone-hid control box: starts at boot, finds the rigs by itself, restarts on failure.
[Unit]
Description=iphone-hid control box
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ihc
Group=ihc
SupplementaryGroups=dialout video input
Environment=IHC_STATE_DIR=/var/lib/ihc
StateDirectory=ihc
LogsDirectory=ihc
ExecStart=/opt/ihc/.venv/bin/ihc serve --auto --state-dir /var/lib/ihc --host 0.0.0.0 --port 8000 --log /var/log/ihc/ihc.jsonl
Restart=always
RestartSec=2
# report pacing is timing sensitive: run ahead of ordinary background work
Nice=-5

[Install]
WantedBy=multi-user.target
